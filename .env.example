# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# APPLICATION SECURITY & CREDENTIALS
# =========================================================================

# ADMIN_USERNAME: Username for the protected administrative portal.
# Defaults to "admin". Set to a secure, private username in production.
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Password for the administrative portal.
# Defaults to "admin@123". MUST be changed to a strong passphrase (min 8-16 chars) in production.
ADMIN_PASSWORD="CHANGE_ME_SECURE_PASSWORD"

# ADMIN_JWT_SECRET: Strong random secret (min 32 characters) for signing and verifying admin session tokens.
# If omitted, a cryptographically secure random secret is generated on server startup.
ADMIN_JWT_SECRET="CHANGE_ME_RANDOM_LONG_SECRET_KEY_FOR_JWT"

# ADMIN_2FA_PIN: Optional 6-digit Security PIN for Two-Factor Authentication on admin login.
# Leave empty if 2FA is disabled, or set to a 6-digit code like "789123".
ADMIN_2FA_PIN=""

# MONGODB_URI: Optional MongoDB Atlas connection URI for persistent cloud storage.
# Example: mongodb+srv://pooja_admin:<password>@cluster0.mongodb.net/sanaatana_pooja_db?retryWrites=true&w=majority
MONGODB_URI=""

# PORT: Port where the backend server runs. Defaults to 3000.
PORT="3000"
